# Copiar a .env.local (desarrollo) y poner las mismas variables en Cloudflare Pages (Settings > Environment variables).
# Estos valores de Firebase son públicos por diseño; la seguridad la dan las reglas de Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=
# Opcional: aparece en el encabezado de los PDF
VITE_EMPRESA_NOMBRE=
